

{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/favicon.svg",
      "/favicon.ico"
    ]
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-store, no-cache, must-revalidate"
      }
    },
    {
      "route": "/",
      "headers": {
        "cache-control": "no-store, no-cache, must-revalidate"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ]
}